<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TeamWeave - Hackathon Team Matcher</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            color: #333;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        header {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            margin-bottom: 30px;
            text-align: center;
        }

        header h1 {
            color: #667eea;
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        header p {
            color: #666;
            font-size: 1.1em;
        }

        .nav-tabs {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .nav-btn {
            padding: 12px 24px;
            border: 2px solid #667eea;
            background: white;
            color: #667eea;
            border-radius: 25px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
            font-size: 1em;
        }

        .nav-btn.active {
            background: #667eea;
            color: white;
        }

        .nav-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

        .content {
            display: none;
        }

        .content.active {
            display: block;
        }

        .section {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            margin-bottom: 30px;
        }

        .section h2 {
            color: #667eea;
            margin-bottom: 20px;
            font-size: 1.8em;
            border-bottom: 3px solid #667eea;
            padding-bottom: 10px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }

        .stat-card h3 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .stat-card p {
            font-size: 0.95em;
            opacity: 0.9;
        }

        .actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 30px;
        }

        button {
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: bold;
        }

        .btn-primary {
            background: #667eea;
            color: white;
        }

        .btn-primary:hover {
            background: #5568d3;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

        .btn-success {
            background: #48bb78;
            color: white;
        }

        .btn-success:hover {
            background: #38a169;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(72, 187, 120, 0.4);
        }

        .btn-danger {
            background: #f56565;
            color: white;
        }

        .btn-danger:hover {
            background: #e53e3e;
            transform: translateY(-2px);
        }

        .btn-info {
            background: #4299e1;
            color: white;
        }

        .btn-info:hover {
            background: #3182ce;
            transform: translateY(-2px);
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: bold;
        }

        input[type="text"],
        input[type="email"],
        input[type="number"],
        select {
            width: 100%;
            padding: 12px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 1em;
            font-family: inherit;
            transition: border-color 0.3s ease;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="number"]:focus,
        select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .checkbox-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 10px;
            margin-top: 10px;
        }

        .checkbox-item {
            display: flex;
            align-items: center;
        }

        .checkbox-item input[type="checkbox"] {
            margin-right: 8px;
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .checkbox-item label {
            margin: 0;
            cursor: pointer;
            font-weight: normal;
        }

        .alert {
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
            animation: slideIn 0.3s ease;
        }

        .alert-success {
            background: #c6efce;
            color: #270;
            border-left: 4px solid #48bb78;
        }

        .alert-error {
            background: #fcc;
            color: #c00;
            border-left: 4px solid #f56565;
        }

        .alert.show {
            display: block;
        }

        @@keyframes slideIn {
            from {
                transform: translateY(-20px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .card {
            background: #f7fafc;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 20px;
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: #667eea;
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.2);
        }

        .card h3 {
            color: #667eea;
            margin-bottom: 15px;
            font-size: 1.3em;
        }

        .card-meta {
            display: flex;
            justify-content: space-between;
            font-size: 0.9em;
            color: #999;
            margin-bottom: 15px;
        }

        .badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: bold;
            margin-right: 8px;
            margin-bottom: 8px;
        }

        .badge-skill {
            background: #667eea;
            color: white;
        }

        .badge-locked {
            background: #f6ad55;
            color: white;
        }

        .badge-status {
            background: #48bb78;
            color: white;
        }

        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            animation: fadeIn 0.3s ease;
        }

        .modal.show {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .modal-content {
            background-color: white;
            padding: 30px;
            border-radius: 15px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            position: relative;
            animation: slideInUp 0.3s ease;
        }

        @@keyframes slideInUp {
            from {
                transform: translateY(50px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 15px;
        }

        .modal-header h2 {
            color: #667eea;
            margin: 0;
        }

        .close {
            font-size: 28px;
            font-weight: bold;
            color: #999;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .close:hover {
            color: #333;
        }

        .loading {
            text-align: center;
            padding: 20px;
            display: none;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #667eea;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 15px;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .table thead {
            background: #f7fafc;
        }

        .table th,
        .table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
        }

        .table th {
            color: #667eea;
            font-weight: bold;
        }

        .table tbody tr:hover {
            background: #f7fafc;
        }

        footer {
            text-align: center;
            color: white;
            padding: 20px;
            margin-top: 40px;
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #999;
        }

        .empty-state h3 {
            color: #667eea;
            margin-bottom: 10px;
        }

        @media (max-width: 768px) {
            header h1 {
                font-size: 1.8em;
            }

            .nav-tabs {
                gap: 5px;
            }

            .nav-btn {
                padding: 8px 16px;
                font-size: 0.9em;
            }

            .section {
                padding: 20px;
            }

            .grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>TeamWeave</h1>
            <p>Hackathon Team Matcher Portal</p>
            <div class="nav-tabs">
                <button class="nav-btn active" onclick="switchTab('dashboard')">Dashboard</button>
                <button class="nav-btn" onclick="switchTab('participants')">Participants</button>
                <button class="nav-btn" onclick="switchTab('teams')">Teams</button>
                <button class="nav-btn" onclick="switchTab('audit')">Audit Trail</button>
            </div>
        </header>

        <div id="alertBox" class="alert"></div>

        <!-- Dashboard Tab -->
        <div id="dashboard" class="content active">
            <div class="section">
                <h2>Statistics</h2>
                <div class="stats-grid">
                    <div class="stat-card">
                        <h3 id="statParticipants">0</h3>
                        <p>Total Participants</p>
                    </div>
                    <div class="stat-card">
                        <h3 id="statTeams">0</h3>
                        <p>Total Teams</p>
                    </div>
                    <div class="stat-card">
                        <h3 id="statSkills">25+</h3>
                        <p>Available Skills</p>
                    </div>
                    <div class="stat-card">
                        <h3 id="statAvgTeamSize">0</h3>
                        <p>Avg Team Size</p>
                    </div>
                </div>
            </div>

            <div class="section">
                <h2>🚀 Quick Actions</h2>
                <div class="actions">
                    <button class="btn-primary" onclick="openRegisterModal()">➕ Register Participant</button>
                    <button class="btn-success" onclick="openClusteringModal()">🔄 Run Clustering</button>
                    <button class="btn-info" onclick="exportParticipants()">📥 Export Participants</button>
                    <button class="btn-info" onclick="exportTeams()">📥 Export Teams</button>
                </div>
            </div>

            <div class="section">
                <h2>👥 Recent Participants</h2>
                <div id="recentParticipants" class="grid">
                    <div class="empty-state">
                        <h3>No participants yet</h3>
                        <p>Register participants to get started</p>
                    </div>
                </div>
            </div>

            <div class="section">
                <h2>👨‍💼 Recent Teams</h2>
                <div id="recentTeams" class="grid">
                    <div class="empty-state">
                        <h3>No teams created</h3>
                        <p>Run clustering algorithm to create teams</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Participants Tab -->
        <div id="participants" class="content">
            <div class="section">
                <h2>👥 All Participants</h2>
                <div class="form-group">
                    <label>Filter by Skill Category:</label>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px;">
                        <button class="btn-primary" onclick="filterParticipants('')" style="padding: 8px 16px; font-size: 0.9em;">All</button>
                        <button class="btn-primary" onclick="filterParticipants('Frontend')" style="padding: 8px 16px; font-size: 0.9em;">Frontend</button>
                        <button class="btn-primary" onclick="filterParticipants('Backend')" style="padding: 8px 16px; font-size: 0.9em;">Backend</button>
                        <button class="btn-primary" onclick="filterParticipants('Data')" style="padding: 8px 16px; font-size: 0.9em;">Data</button>
                        <button class="btn-primary" onclick="filterParticipants('Design')" style="padding: 8px 16px; font-size: 0.9em;">Design</button>
                        <button class="btn-primary" onclick="filterParticipants('DevOps')" style="padding: 8px 16px; font-size: 0.9em;">DevOps</button>
                    </div>
                </div>
                <div id="participantsList" class="grid">
                    <div class="empty-state">
                        <h3>No participants registered</h3>
                        <p>Register participants from the Dashboard</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Teams Tab -->
        <div id="teams" class="content">
            <div class="section">
                <h2>👨‍💼 All Teams</h2>
                <div id="teamsList" class="grid">
                    <div class="empty-state">
                        <h3>No teams created</h3>
                        <p>Run clustering to automatically form teams</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Audit Trail Tab -->
        <div id="audit" class="content">
            <div class="section">
                <h2>📋 Audit Trail</h2>
                <div id="auditTable">
                    <div class="empty-state">
                        <h3>No audit logs</h3>
                        <p>Changes will appear here</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Register Modal -->
    <div id="registerModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Register Participant</h2>
                <span class="close" onclick="closeRegisterModal()">&times;</span>
            </div>
            <div class="form-group">
                <label>Name:</label>
                <input type="text" id="participantName" placeholder="Enter full name">
            </div>
            <div class="form-group">
                <label>Email:</label>
                <input type="email" id="participantEmail" placeholder="Enter email address">
            </div>
            <div class="form-group">
                <label>Select Skills (at least one):</label>
                <div id="skillsCheckbox" class="checkbox-group"></div>
            </div>
            <button class="btn-success" onclick="registerParticipant()" style="width: 100%;">✓ Register</button>
        </div>
    </div>

    <!-- Clustering Modal -->
    <div id="clusteringModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Run Clustering Algorithm</h2>
                <span class="close" onclick="closeClusteringModal()">&times;</span>
            </div>
            <div class="form-group">
                <label>Team Size:</label>
                <input type="number" id="teamSize" value="4" min="2" max="10">
            </div>
            <div class="form-group">
                <label>Event ID:</label>
                <input type="number" id="eventId" value="1" min="1">
            </div>
            <div class="loading" id="clusteringLoading">
                <div class="spinner"></div>
                <p>Running clustering algorithm...</p>
            </div>
            <button class="btn-success" onclick="runClustering()" style="width: 100%; display: none;" id="clusteringBtn">🔄 Run Clustering</button>
        </div>
    </div>

    <footer>
        <p>&copy; 2024 TeamWeave - Built with ❤️ for seamless team formation</p>
    </footer>

    <script>
        // Mock Data Storage
        let app = {
            participants: [],
            teams: [],
            auditLogs: [],
            skills: [
                // Frontend
                { id: 1, name: 'React', category: 'Frontend' },
                { id: 2, name: 'Vue.js', category: 'Frontend' },
                { id: 3, name: 'Angular', category: 'Frontend' },
                { id: 4, name: 'JavaScript', category: 'Frontend' },
                { id: 5, name: 'HTML/CSS', category: 'Frontend' },
                // Backend
                { id: 6, name: 'C#', category: 'Backend' },
                { id: 7, name: 'Python', category: 'Backend' },
                { id: 8, name: 'Java', category: 'Backend' },
                { id: 9, name: 'Node.js', category: 'Backend' },
                { id: 10, name: 'PHP', category: 'Backend' },
                // Data
                { id: 11, name: 'SQL', category: 'Data' },
                { id: 12, name: 'Python Data Science', category: 'Data' },
                { id: 13, name: 'Machine Learning', category: 'Data' },
                { id: 14, name: 'Data Analysis', category: 'Data' },
                { id: 15, name: 'Big Data', category: 'Data' },
                // Design
                { id: 16, name: 'UI/UX Design', category: 'Design' },
                { id: 17, name: 'Figma', category: 'Design' },
                { id: 18, name: 'Graphic Design', category: 'Design' },
                { id: 19, name: 'Web Design', category: 'Design' },
                // DevOps
                { id: 20, name: 'Docker', category: 'DevOps' },
                { id: 21, name: 'Kubernetes', category: 'DevOps' },
                { id: 22, name: 'AWS', category: 'DevOps' },
                { id: 23, name: 'Azure', category: 'DevOps' },
                { id: 24, name: 'CI/CD', category: 'DevOps' }
            ]
        };

        // Initialize
        window.onload = function () {
            initializeSkillsCheckbox();
            loadData();
        };

        // Initialize Skills Checkbox
        function initializeSkillsCheckbox() {
            const container = document.getElementById('skillsCheckbox');
            app.skills.forEach(skill => {
                const div = document.createElement('div');
                div.className = 'checkbox-item';
                div.innerHTML = `
                    <input type="checkbox" id="skill_${skill.id}" name="skills" value="${skill.name}">
                    <label for="skill_${skill.id}">${skill.name}</label>
                `;
                container.appendChild(div);
            });
        }

        // Tab Switching
        function switchTab(tabName) {
            // Hide all content
            document.querySelectorAll('.content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));

            // Show selected tab
            document.getElementById(tabName).classList.add('active');
            event.target.classList.add('active');

            // Load tab data
            if (tabName === 'participants') {
                displayParticipants(app.participants);
            } else if (tabName === 'teams') {
                displayTeams(app.teams);
            } else if (tabName === 'audit') {
                displayAuditLogs();
            }
        }

        // Load Data
        function loadData() {
            updateStats();
            displayRecentParticipants();
            displayRecentTeams();
        }

        // Update Statistics
        function updateStats() {
            document.getElementById('statParticipants').textContent = app.participants.length;
            document.getElementById('statTeams').textContent = app.teams.length;
            const avgSize = app.teams.length > 0 
                ? Math.round(app.participants.length / app.teams.length) 
                : 0;
            document.getElementById('statAvgTeamSize').textContent = avgSize;
        }

        // Register Participant
        function registerParticipant() {
            const name = document.getElementById('participantName').value;
            const email = document.getElementById('participantEmail').value;
            const skills = Array.from(document.querySelectorAll('input[name="skills"]:checked')).map(cb => cb.value);

            if (!name || !email || skills.length === 0) {
                showAlert('Please fill all fields and select at least one skill', 'error');
                return;
            }

            const participant = {
                id: app.participants.length + 1,
                name: name,
                email: email,
                skills: skills.map(skillName => {
                    const skill = app.skills.find(s => s.name === skillName);
                    return { ...skill, proficiency: 3 };
                }),
                createdAt: new Date()
            };

            app.participants.push(participant);
            addAuditLog(`Participant '${name}' registered`);
            showAlert(`✓ ${name} registered successfully!`, 'success');
            closeRegisterModal();
            resetRegisterForm();
            loadData();
        }

        // Run Clustering
        function runClustering() {
            const teamSize = parseInt(document.getElementById('teamSize').value);
            const eventId = parseInt(document.getElementById('eventId').value);

            if (app.participants.length === 0) {
                showAlert('No participants to cluster', 'error');
                return;
            }

            if (!teamSize || teamSize < 2) {
                showAlert('Team size must be at least 2', 'error');
                return;
            }

            document.getElementById('clusteringLoading').style.display = 'block';
            document.getElementById('clusteringBtn').style.display = 'none';

            // Simulate clustering
            setTimeout(() => {
                const numTeams = Math.ceil(app.participants.length / teamSize);
                app.teams = [];

                for (let i = 0; i < numTeams; i++) {
                    const start = i * teamSize;
                    const end = Math.min(start + teamSize, app.participants.length);
                    const members = app.participants.slice(start, end);

                    const team = {
                        id: app.teams.length + 1,
                        name: `Team ${i + 1}`,
                        eventId: eventId,
                        status: 'Draft',
                        isLocked: false,
                        members: members,
                        createdAt: new Date()
                    };

                    app.teams.push(team);
                }

                addAuditLog(`Clustering executed: Created ${numTeams} teams`);
                showAlert(`✓ Created ${numTeams} teams successfully!`, 'success');
                closeClusteringModal();
                loadData();
                document.getElementById('clusteringLoading').style.display = 'none';
                document.getElementById('clusteringBtn').style.display = 'block';
            }, 1500);
        }

        // Display Recent Participants
        function displayRecentParticipants() {
            const container = document.getElementById('recentParticipants');
            const recent = app.participants.slice(-3);

            if (recent.length === 0) {
                container.innerHTML = '<div class="empty-state"><h3>No participants yet</h3><p>Register participants to get started</p></div>';
                return;
            }

            container.innerHTML = recent.map(p => `
                <div class="card">
                    <h3>${p.name}</h3>
                    <div class="card-meta">
                        <span>📧 ${p.email}</span>
                        <span>${p.skills.length} skills</span>
                    </div>
                    <div>
                        ${p.skills.map(s => `<span class="badge badge-skill">${s.name}</span>`).join('')}
                    </div>
                </div>
            `).join('');
        }

        // Display Recent Teams
        function displayRecentTeams() {
            const container = document.getElementById('recentTeams');
            const recent = app.teams.slice(-3);

            if (recent.length === 0) {
                container.innerHTML = '<div class="empty-state"><h3>No teams created</h3><p>Run clustering algorithm to create teams</p></div>';
                return;
            }

            container.innerHTML = recent.map(t => `
                <div class="card">
                    <h3>${t.name} ${t.isLocked ? '<span class="badge badge-locked">🔒 LOCKED</span>' : ''}</h3>
                    <div class="card-meta">
                        <span>👥 ${t.members.length} members</span>
                        <span class="badge badge-status">${t.status}</span>
                    </div>
                    <small>${t.members.map(m => m.name).join(', ')}</small>
                </div>
            `).join('');
        }

        // Display All Participants
        function displayParticipants(participants) {
            const container = document.getElementById('participantsList');

            if (participants.length === 0) {
                container.innerHTML = '<div class="empty-state"><h3>No participants registered</h3><p>Register participants from the Dashboard</p></div>';
                return;
            }

            container.innerHTML = participants.map(p => `
                <div class="card">
                    <h3>${p.name}</h3>
                    <div class="card-meta">
                        <span>📧 ${p.email}</span>
                    </div>
                    <div style="margin-bottom: 10px;">
                        ${p.skills.map(s => `<span class="badge badge-skill">${s.name} ${s.proficiency}⭐</span>`).join('')}
                    </div>
                    <small style="color: #999;">Registered: ${new Date(p.createdAt).toLocaleDateString()}</small>
                </div>
            `).join('');
        }

        // Filter Participants
        function filterParticipants(category) {
            if (!category) {
                displayParticipants(app.participants);
                return;
            }

            const filtered = app.participants.filter(p =>
                p.skills.some(s => s.category === category)
            );

            displayParticipants(filtered);
        }

        // Display All Teams
        function displayTeams(teams) {
            const container = document.getElementById('teamsList');

            if (teams.length === 0) {
                container.innerHTML = '<div class="empty-state"><h3>No teams created</h3><p>Run clustering to automatically form teams</p></div>';
                return;
            }

            container.innerHTML = teams.map(t => `
                <div class="card">
                    <h3>${t.name} ${t.isLocked ? '<span class="badge badge-locked">🔒 LOCKED</span>' : ''}</h3>
                    <div class="card-meta">
                        <span>👥 ${t.members.length} members</span>
                        <span class="badge badge-status">${t.status}</span>
                    </div>
                    <div style="font-size: 0.9em; margin: 10px 0;">
                        ${t.members.map(m => `
                            <div style="padding: 8px; background: #f0f0f0; margin-bottom: 5px; border-radius: 5px;">
                                <strong>${m.name}</strong>
                                <div style="font-size: 0.85em; color: #666;">
                                    ${m.skills.map(s => s.name).join(', ')}
                                </div>
                            </div>
                        `).join('')}
                    </div>
                    <button class="btn-primary" onclick="lockTeam(${t.id})" style="width: 100%; margin-top: 10px; padding: 8px;">
                        ${t.isLocked ? '🔓 Unlock' : '🔒 Lock'}
                    </button>
                </div>
            `).join('');
        }

        // Lock Team
        function lockTeam(teamId) {
            const team = app.teams.find(t => t.id === teamId);
            if (team) {
                team.isLocked = !team.isLocked;
                team.status = team.isLocked ? 'Locked' : 'Draft';
                addAuditLog(`Team '${team.name}' ${team.isLocked ? 'locked' : 'unlocked'}`);
                showAlert(`✓ Team ${team.isLocked ? 'locked' : 'unlocked'} successfully!`, 'success');
                displayTeams(app.teams);
            }
        }

        // Display Audit Logs
        function displayAuditLogs() {
            const container = document.getElementById('auditTable');

            if (app.auditLogs.length === 0) {
                container.innerHTML = '<div class="empty-state"><h3>No audit logs</h3><p>Changes will appear here</p></div>';
                return;
            }

            const html = `
                <table class="table">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Event</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${app.auditLogs.map((log, i) => `
                            <tr>
                                <td>${new Date(log.timestamp).toLocaleString()}</td>
                                <td>${log.event}</td>
                                <td>${log.details || '-'}</td>
                            </tr>
                        `).reverse().join('')}
                    </tbody>
                </table>
            `;
            container.innerHTML = html;
        }

        // Add Audit Log
        function addAuditLog(event, details = '') {
            app.auditLogs.push({
                timestamp: new Date(),
                event: event,
                details: details
            });
        }

        // Export Functions
        function exportParticipants() {
            const csv = 'Name,Email,Skills,Skills Count,Registered\n' +
                app.participants.map(p => `"${p.name}","${p.email}","${p.skills.map(s => s.name).join('; ')}",${p.skills.length},"${new Date(p.createdAt).toLocaleDateString()}"`).join('\n');

            downloadCSV(csv, 'participants.csv');
        }

        function exportTeams() {
            const csv = 'Team Name,Members,Member Count,Status\n' +
                app.teams.map(t => `"${t.name}","${t.members.map(m => m.name).join('; ')}",${t.members.length},"${t.status}"`).join('\n');

            downloadCSV(csv, 'teams.csv');
        }

        function downloadCSV(csv, filename) {
            const link = document.createElement('a');
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            link.href = url;
            link.download = filename;
            link.click();
            window.URL.revokeObjectURL(url);
            showAlert(`✓ ${filename} downloaded!`, 'success');
        }

        // Modal Functions
        function openRegisterModal() {
            document.getElementById('registerModal').classList.add('show');
        }

        function closeRegisterModal() {
            document.getElementById('registerModal').classList.remove('show');
            resetRegisterForm();
        }

        function resetRegisterForm() {
            document.getElementById('participantName').value = '';
            document.getElementById('participantEmail').value = '';
            document.querySelectorAll('input[name="skills"]').forEach(cb => cb.checked = false);
        }

        function openClusteringModal() {
            if (app.participants.length === 0) {
                showAlert('Please register participants first', 'error');
                return;
            }
            document.getElementById('clusteringModal').classList.add('show');
            document.getElementById('clusteringBtn').style.display = 'block';
        }

        function closeClusteringModal() {
            document.getElementById('clusteringModal').classList.remove('show');
        }

        // Alert Function
        function showAlert(message, type) {
            const alertBox = document.getElementById('alertBox');
            alertBox.textContent = message;
            alertBox.className = `alert alert-${type} show`;
            setTimeout(() => {
                alertBox.classList.remove('show');
            }, 4000);
        }

        // Close modal when clicking outside
        window.onclick = function (event) {
            const registerModal = document.getElementById('registerModal');
            const clusteringModal = document.getElementById('clusteringModal');
            if (event.target === registerModal) {
                closeRegisterModal();
            }
            if (event.target === clusteringModal) {
                closeClusteringModal();
            }
        }

        // Auto-refresh stats
        setInterval(() => {
            if (document.getElementById('dashboard').classList.contains('active')) {
                updateStats();
            }
        }, 10000);
    </script>
</body>
</html>
